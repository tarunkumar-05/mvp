# Public base URL of the Rapqo FastAPI backend, no trailing slash.
# Local development defaults to http://127.0.0.1:8000 when this is unset.
# On Vercel this MUST be set to a publicly reachable HTTPS URL, otherwise the
# console falls back to localhost and shows "Backend Offline" for every visitor.
# NEXT_PUBLIC_* values are inlined at build time, so changing this requires a
# redeploy, not just a refresh.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
