# Rapqo email configuration (copy to backend/.env and fill in real values).
# Without SMTP credentials the inbound webhook still drafts the quote and the
# API simply reports email_sent=false.

# --- Outbound SMTP -----------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sales@yourdomain.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=sales@yourdomain.com
SMTP_USE_SSL=false
SMTP_USE_TLS=true

# --- Inbound IMAP (optional listener) ---------------------------------------
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
EMAIL_USER=sales@yourdomain.com
EMAIL_PASSWORD=your-app-password
IMAP_MAILBOX=INBOX
IMAP_POLL_SECONDS=5
EMAIL_LISTENER_ENABLED=false

# Address shown in the frontend "Live Evaluator Test" banner.
INBOUND_EMAIL_ADDRESS=sales@yourdomain.com

# --- Optional LLM extraction ------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
